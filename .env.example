# ───────────────────────────────────────────────────────────────
# 햇살마을 환경 변수 예시 — 이 파일을 .env.local 로 복사해서 값을 채우세요.
# (Netlify 에서는 Site settings → Environment variables 에 같은 이름으로 등록)
# ───────────────────────────────────────────────────────────────

# Supabase 프로젝트 URL (Supabase 대시보드 → Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon(public) 키 — 공개되어도 되는 키입니다. RLS 정책으로 보호됩니다.
# (Project Settings → API → Project API keys → anon public)
# ⚠ service_role 키는 절대 여기에 넣지 마세요!
VITE_SUPABASE_ANON_KEY=your-anon-key

# 백엔드 모드: supabase | local
#  - supabase : 실제 서버 사용 (배포용)
#  - local    : 서버 없이 브라우저 localStorage 로 동작하는 체험/개발 모드
#               (같은 브라우저의 여러 탭끼리 멀티플레이 테스트 가능)
# 비워두면 Supabase 값이 있을 때 supabase, 없으면 local 로 동작합니다.
VITE_BACKEND=
